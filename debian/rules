#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export PATH = /usr/sbin:/usr/bin:/sbin:/bin
export QT_QPA_PLATFORM = offscreen
export CARGO_HOME = $(CURDIR)/debian/cargo-home

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DBUILD_TESTING=ON \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=libexec \
		-DMARK_SHOT_CARGO_VENDOR_DIR=vendor \
		-DMARK_SHOT_REQUIRE_FFMPEG=ON \
		-DMARK_SHOT_REQUIRE_LAYER_SHELL=ON \
		-DMARK_SHOT_REQUIRE_LIBPORTAL=ON \
		-DMARK_SHOT_WITH_LAYER_SHELL=ON \
		-DMARK_SHOT_WITH_LIBPORTAL=ON

override_dh_auto_install:
	dh_auto_install
	sed -i '1s|^#!/usr/bin/env python3$$|#!/usr/bin/python3|' \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-ocr \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-code-scan \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-translate \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-upload \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-window-detection-niri \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-window-detection-hyprland \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-window-detection-gnome \
		debian/mark-shot/usr/libexec/mark-shot/mark-shot-window-detection-kde
	rm -f debian/mark-shot/usr/share/doc/mark-shot/CHANGELOG.md

# dh_clean 默认删除 *.orig，会破坏 vendor/ 中 crate 自带的 Cargo.toml.orig 及其校验和
override_dh_clean:
	dh_clean -Xvendor/

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

# 【打包】【OCR依赖】显式声明动态加载的运行库，失败时不得生成缺少依赖的包
override_dh_gencontrol:
	dependency="$$(python3 qt/scripts/debian-ocr-runtime-dependency.py)" && \
		dh_gencontrol -- -Vmarkshot:OcrDepends="$$dependency"
